FROM node:24-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY --from=build /web/dist/ ./web/
COPY scripts/serve_frontend.py ./serve_frontend.py
ENV FRONTEND_DIST=/app/web PORT=8080 FRONTEND_API=http://api:8090
EXPOSE 8080
CMD ["python", "serve_frontend.py"]
