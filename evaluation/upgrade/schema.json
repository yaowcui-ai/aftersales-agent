{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upgrade scenario catalog v2",
  "type": "array",
  "minItems": 120,
  "items": {
    "type": "object",
    "required": ["case_id", "condition", "category", "split", "initial_state", "user_turns", "input_steps", "expected_tools", "expected_db", "expected_errors", "approval_required", "forbidden_actions", "language_template"],
    "properties": {
      "case_id": {"type": "string", "pattern": "^U[0-9]{3}$"},
      "condition": {"type": "string", "minLength": 1},
      "category": {"enum": ["refund", "return", "reship", "read", "logistics", "clarification", "revision", "security", "approval", "state", "fault"]},
      "split": {"enum": ["dev", "validation", "test"]},
      "initial_state": {"type": "object", "required": ["status", "paid_cents", "refunded_cents", "quantity", "reshipped_quantity", "stock", "owner", "risk_level", "aftersales_until", "manual_review_threshold_cents", "shipments"]},
      "user_turns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "input_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}},
      "expected_tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
      "expected_db": {"type": "object", "minProperties": 1},
      "expected_errors": {"type": "array", "items": {"type": "string"}},
      "approval_required": {"type": "boolean"},
      "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "language_template": {"type": "string", "minLength": 1},
      "core_repeat": {"type": "boolean"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {"tool": {"type": "string", "minLength": 1}, "args": {"type": "object"}},
      "additionalProperties": false
    }
  }
}
